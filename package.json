{
  "name": "newsim-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@newsim/management",
    "build": "next build",
    "start": "next start",
    "dev:management": "npm run dev --workspace=@newsim/management",
    "dev:instructor": "npm run dev --workspace=@newsim/instructor",
    "dev:trainee": "npm run dev --workspace=@newsim/trainee",
    "dev:backend": "npm run dev --workspace=@newsim/backend",
    "build:management": "npm run build --workspace=@newsim/management",
    "build:instructor": "npm run build --workspace=@newsim/instructor",
    "build:trainee": "npm run build --workspace=@newsim/trainee",
    "build:backend": "npm run build --workspace=@newsim/backend",
    "build:all": "npm run build:management && npm run build:instructor && npm run build:trainee",
    "lint": "eslint",
    "typecheck:management": "tsc --noEmit -p apps/management/tsconfig.json",
    "typecheck:instructor": "tsc --noEmit -p apps/instructor/tsconfig.json",
    "typecheck:trainee": "tsc --noEmit -p apps/trainee/tsconfig.json",
    "typecheck:backend": "tsc --noEmit -p backend/tsconfig.json",
    "typecheck:all": "npm run typecheck:management && npm run typecheck:instructor && npm run typecheck:trainee"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-separator": "^1.1.15",
    "@supabase/supabase-js": "^2.112.4",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.70.0",
    "next": "16.3.1",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pg": "^8.23.0",
    "prisma": "^6.12.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
