# ==============================================================================
# NEWSIM MARITIME TRAINING MANAGEMENT SYSTEM — MONOREPO ENVIRONMENT TEMPLATE
# Never commit real secret values. Copy to .env.local for local development
# or configure in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# --- Supabase (Required across Management, Instructor, Trainee) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- PostgreSQL Direct / Pooler Connection (Optional for migrations/admin scripts) ---
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Session & JWT Security (Required in Production, minimum 32 random chars) ---
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET

# --- Portal Cross-Navigation URLs (Set to deployed Vercel domains in Production) ---
NEXT_PUBLIC_LANDING_URL=https://YOUR-LANDING-DOMAIN.vercel.app
NEXT_PUBLIC_APP_URL=https://YOUR-CURRENT-PORTAL-DOMAIN.vercel.app
NEXT_PUBLIC_SITE_URL=https://YOUR-CURRENT-PORTAL-DOMAIN.vercel.app
NEXT_PUBLIC_INSTRUCTOR_URL=https://YOUR-INSTRUCTOR-DOMAIN.vercel.app
NEXT_PUBLIC_TRAINEE_URL=https://YOUR-TRAINEE-DOMAIN.vercel.app

# --- SMTP Email Dispatch (Required for OTP, Google Number Match, Invitations, Password Reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-verified-sender@gmail.com
SMTP_PASS=YOUR_SMTP_APP_PASSWORD

# --- PayMongo Gateway (Initially TEST MODE ONLY — Do not switch to LIVE without explicit approval) ---
PAYMONGO_MODE=TEST
PAYMONGO_SECRET_KEY=sk_test_YOUR_PAYMONGO_TEST_SECRET_KEY
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_YOUR_PAYMONGO_TEST_PUBLIC_KEY
PAYMONGO_WEBHOOK_SECRET=whsec_YOUR_PAYMONGO_WEBHOOK_SIGNING_SECRET

# --- Google reCAPTCHA (Trainee Registration & Password Recovery) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY
RECAPTCHA_SECRET_KEY=YOUR_RECAPTCHA_V3_SECRET_KEY
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_V2_SECRET_KEY=

# --- Optional Analytics & Scheduled Jobs ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
CRON_SECRET=
ALLOWED_APP_HOSTS=
